FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY backend ./backend
COPY deploy/homelab/api ./deploy/homelab/api

RUN mkdir -p /data /firmware /backups \
    && chown -R node:node /data /firmware /backups

USER node
EXPOSE 8787

CMD ["node", "--no-warnings=ExperimentalWarning", "deploy/homelab/api/server.mjs"]
