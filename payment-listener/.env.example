# Telegram user-client API credentials — from https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Chat where ABA bank notifications arrive (group/channel id, negative for supergroups)
ABA_GROUP_ID=-10022334455

# BikeBoss worker webhook
BIKEBOSS_WEBHOOK_URL=https://api.creative-studio.blog/webhook/abapayway

# Shared secret — must match PAYMENT_WEBHOOK_SECRET set on the worker
PAYMENT_WEBHOOK_SECRET=change-me-long-random-string
