# Local development secrets — copy to .dev.vars and fill real values.
# .dev.vars is gitignored; never commit real credentials.

TELEGRAM_BOT_TOKEN=123456:placeholder
ABA_PAYWAY_MERCHANT_ID=placeholder
ABA_PAYWAY_API_KEY=placeholder
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
DEVICE_KEY_MASTER=replace-with-at-least-32-random-bytes

# Optional overrides
GEOFENCE_DEFAULT_RADIUS_M=100
GEOFENCE_DEFAULT_ACCURACY_M=15
HEARTBEAT_TIMEOUT_MS=600000
